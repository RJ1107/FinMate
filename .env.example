APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
MARKET_PROVIDER=auto
MARKET_CACHE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000/api/v1

# OpenRouter LLM configuration. Keep the real key only in .env or deployment secrets.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v3.2
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_APP_TITLE=FinMate
